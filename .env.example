# Browser (bundled into the site — public values only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Set to "local" to run on the in-browser mock data instead of Supabase
# VITE_DATA_SOURCE=local
# LINE Login channel (public). The Channel secret lives only in Supabase Edge Function
# secrets as LINE_CHANNEL_SECRET — never here.
# VITE_LINE_CHANNEL_ID=2012661380

# Server / scripts only (npm run handshake). Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
